{
  "name": "sas-supplier-web",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio web de SAS South America Supplier con panel de configuración. Desarrollado por Zaire Technologies.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "assets:map": "node scripts/build-map.mjs",
    "assets:3d": "node scripts/bundle-3d-harness.mjs && python3 scripts/3d/render-products.py",
    "typecheck": "tsc --noEmit",
    "qa:e2e": "python3 scripts/qa/admin-flow.py http://localhost:3000",
    "qa:gallery": "python3 scripts/qa/gallery.py http://localhost:3000 qa-capturas"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.28",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.39.0",
    "server-only": "^0.0.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "d3-geo": "^3.1.2",
    "esbuild": "^0.28.2",
    "topojson-client": "^3.1.0",
    "typescript": "^5.9.3",
    "world-atlas": "^2.0.2"
  }
}
